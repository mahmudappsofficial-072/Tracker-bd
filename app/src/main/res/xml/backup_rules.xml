<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Local Room DB is automatically excluded because only domain="sharedpref" is included below; Firestore is the authoritative cloud backup. -->
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="com.google.firebase"/>
    <exclude domain="sharedpref" path="overtime_sync_prefs.xml"/>
    <exclude domain="sharedpref" path="overtime_tombstones.xml"/>
</full-backup-content>
