<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Automatic Cloud Backup to Google Drive (excluding local DB and account sync prefs; Firestore handles cloud restore) -->
    <cloud-backup>
        <exclude domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="com.google.firebase"/>
        <exclude domain="sharedpref" path="overtime_sync_prefs.xml"/>
        <exclude domain="sharedpref" path="overtime_tombstones.xml"/>
    </cloud-backup>

    <!-- Direct Device-to-Device Transfer (exclude local DB & sync prefs to keep account state clean) -->
    <device-transfer>
        <exclude domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="com.google.firebase"/>
        <exclude domain="sharedpref" path="overtime_sync_prefs.xml"/>
        <exclude domain="sharedpref" path="overtime_tombstones.xml"/>
    </device-transfer>
</data-extraction-rules>
