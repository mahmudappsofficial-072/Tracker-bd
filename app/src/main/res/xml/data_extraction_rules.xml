<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Automatic Cloud Backup to Google Drive (Android 12+) -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="overtime_locale_prefs.xml" />
        <include domain="sharedpref" path="app_update_prefs.xml" />
    </cloud-backup>

    <!-- Direct Device-to-Device Transfer (Android 12+) -->
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="overtime_locale_prefs.xml" />
        <include domain="sharedpref" path="app_update_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
